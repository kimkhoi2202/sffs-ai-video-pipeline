# ──────────────────────────────────────────────────────────────
# SFFS AI video pipeline — .gitignore
# ──────────────────────────────────────────────────────────────

# Secrets — NEVER commit. Live API keys live in voice/.env
**/.env
**/.env.*
!**/.env.example
*.key

# Node
**/node_modules/

# Remotion render artifacts (frame dumps / caches / webpack bundle — regenerable)
remotion/out/
remotion/.remotion/
remotion/build/

# Downloaded build tools — NOT committed (heavy + re-downloadable). The mascot
# lip-sync uses the Rhubarb Lip Sync release (binary + ~tens-of-MB speech models)
# unzipped into tools/. remotion/scripts/lipsync-core.ts (findRhubarb) locates it
# via $RHUBARB, a tools/rhubarb symlink, or a tools/Rhubarb-Lip-Sync-* dir; grab
# it from https://github.com/DanielSWolf/rhubarb-lip-sync/releases (see README).
tools/*
# ...but DO track the committable media-hosting + posting tooling (text only, no secrets).
!tools/upload-media.ts
!tools/README-media-hosting.md
!tools/post-to-publer.ts
!tools/post-variant.ts
!tools/schedule-variants.ts
!tools/edit-captions.ts
!tools/package.json

# Python
__pycache__/
*.py[cod]

# Large, regenerable OUTPUT masters — keep source + audio, drop final mp4s.
# The render tree is renders.nosync/ (the ".nosync" suffix makes iCloud skip the
# whole tree so the thousands of heavy mp4s never sync). Recursive so the per-video
# mp4s under renders.nosync/videos/<platform>/<slug>/ are ignored too, while their
# questions.json / info.md / captions.srt|vtt / the manifest.json ARE tracked.
renders.nosync/*.mp4
renders.nosync/**/*.mp4
# Rendered stills / thumbnails + other heavy media (regenerable) — like the mp4s,
# keep the media OUT of git but still track the sidecar metadata next to it.
renders.nosync/**/*.png
renders.nosync/**/*.jpg
renders.nosync/**/*.jpeg
renders.nosync/**/*.wav

# Local shape/preview review artifacts (regenerable from the NonverbalPreview composition)
renders.nosync/previews/

# Transient scratch (old-render trash staged for deletion) — never commit
renders.nosync/.trash-old/

# Per-round generated narration (mp3s + durations + scratch beats/props) — the
# meta beats + committed round-15 narration stay tracked; mass-gen rounds are
# regenerable from their round JSON via TTS, so keep them out of git.
remotion/public/audio/rounds/

# Fresh backup takes the voice scripts write next to the active clips.
voice/narration/*.bak
voice/narration/*.bak.mp3
voice/narration/_countdownbak/
voice/narration/_oldaccount_bak/

# Local pre-op backups (atempo/TTS regen snapshots) — regenerable, keep out of git.
voice/_backups/

# Editor / OS / misc
.DS_Store
*.log
.vercel/
