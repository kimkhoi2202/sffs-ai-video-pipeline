# EXAMPLE secrets for the SFFS Nous-based agent. Copy to $HERMES_HOME/.env
# (untracked). Values live ONLY on the operator machine / VPS, NEVER in git.
#
# The current loop's authoritative secret file on the VPS is /home/ec2-user/hermes.env.
# Source these from there (or the operator's password manager) for the rebuild.

# ── TrueFoundry (OpenAI-compatible) — the model brain ──
# The "custom" provider does NOT read OPENAI_API_KEY on its own (env_vars=()); put
# the key here and reference it from config.yaml as `model.api_key: "${OPENAI_API_KEY}"`.
OPENAI_API_KEY=            # <-- TrueFoundry API key (a.k.a. TFY_API_KEY)
# TFY_API_KEY=            # legacy name used by the current loop's llm.ts


# ── S3 media (private bucket + presigned GET) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=hermes-sffs-media

# ── ElevenLabs cloned-voice narration ──
ELEVENLABS_API_KEY=

# ── GitHub (software factory: open + auto-merge PRs on GREEN CI, scoped repos) ──
GH_TOKEN=                  # scoped to the SFFS pipeline + the agent's own repo(s)
