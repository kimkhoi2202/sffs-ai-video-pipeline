# EXAMPLE Hermes config for the SFFS Nous-based agent.
# Copy to $HERMES_HOME/config.yaml. HERMES_HOME must be an ISOLATED dir
# (e.g. /Users/khoilam/hermes-nous-build/.hermes-home), never the real ~/.hermes.
# Put the TrueFoundry key in $HERMES_HOME/.env (see hermes.env.example) — NOT here.

model:
  provider: "custom"                                            # OpenAI-compatible endpoint
  base_url: "https://tfy.promptlens.trilogy.com/api/llm/v1"     # TrueFoundry gateway
  default: "claude-opus-4-8"                                    # design/validation/factory brain
  # caption/routine copy can pin claude-haiku-4-5 via auxiliary/per-call model override
  # The `custom` provider has env_vars=() and is EXCLUDED from Hermes's auto
  # env-key registry, so it does NOT read OPENAI_API_KEY on its own. Feed it via
  # this ${VAR} reference — hermes loads $HERMES_HOME/.env at startup and expands
  # ${OPENAI_API_KEY} from the process env, keeping the real secret out of git.
  # (Verified iteration 2: raw curl 200 but the agent loop 401'd until this line.)
  api_key: "${OPENAI_API_KEY}"

# ── Subagent software factory — AGGRESSIVE-BUT-BOUNDED cost stance ──────
# Revised iteration 3 (directive): go FAST — run MANY parallel subagents and use
# Opus generously — but under a HIGH REAL CEILING with a HARD STOP, never
# unbounded. This is a SHARED COMPANY SANDBOX (billing is the company's/Grace's),
# so a runaway MUST be catchable + stoppable. "Unlimited / 10,000 concurrent Opus
# agents" is infeasible (gateway concurrency + rate limits) AND unsafe — do NOT
# design for it.
#   PREREQUISITE (later iteration): the cost governor (a pre_llm_call/pre_tool_call
#   hook that tallies daily $/tokens and HARD-STOPS at the ceiling) + a kill-switch
#   env (HERMES_SFFS_FACTORY_KILL=1 halts all new subagent/LLM work instantly) MUST
#   land before the factory actually runs at this concurrency on shared billing.
#   Until then subagent_auto_approve stays false so nothing auto-spawns unbounded.
delegation:
  max_concurrent_children: 8   # high-but-finite (was 2). At cutover on c6i.4xlarge–8xlarge, ~16.
  max_spawn_depth: 2           # bounded fan-out depth
  subagent_auto_approve: false # flip to true (bounded) once the cost governor + kill-switch exist

agent:
  reasoning_effort: "medium"

memory:
  memory_enabled: true
  user_profile_enabled: true

plugins:                    # user plugins are opt-in; the sffs safety core must be enabled
  enabled:
    - sffs                  # run scripts/link-plugin.sh to symlink + enable it in $HERMES_HOME
