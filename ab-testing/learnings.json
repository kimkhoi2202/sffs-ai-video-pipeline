{
  "schema_version": 1,
  "updated_at": "2026-08-04T00:35:03.578Z",
  "campaign": "Smart Fella or Fart Smella",
  "description": "The campaign 'brain': decision-oriented rollups distilled from ab-database.json. ab-database.json holds raw per-post facts (one row per post); learnings.json is the aggregated view the posting loop uses to decide what to render/post next. Append-only decisions_log; rollups are recomputed from ab-database.json on each metrics pull.",
  "brand_voice": {
    "what": "SFFS brand-voice database: distilled voice principles + hard rules + a large, categorized corpus of REAL copy mined from the website and video pipeline. The auto-replier and the caption / variant generators MUST read this before writing any copy.",
    "files": {
      "guide": "brand/brand-voice.md",
      "examples_md": "brand/brand-voice-examples.md",
      "examples_json": "brand/brand-voice-examples.json",
      "hook_bank": "ab-testing/hook-bank.json"
    },
    "corpus": {
      "surfaces": 33,
      "examples": 230
    },
    "hard_rules": "concise; funny; Gen Z lowercase-casual; kid-safe (no HARD/explicit profanity, but mild slang like 'af' is on-brand and allowed); NO em dashes and NO en dashes; the brain+wind logo glyph is FREE and does not count, plus at most ONE other tasteful emoji (never spam); no AI-slop tone; no over-explaining/lecturing; always end social copy with a follow / come-back nudge.",
    "claims_rule": "Difficulty puffery about the PUZZLE is permitted and needs no substantiation ('97% get this wrong', 'only 3% can solve this', '9 out of 10 pick B'). Claims about the PRODUCT or the viewer's OUTCOME are forbidden with or without a number ('users gain 20 IQ points', 'watch daily and get smarter', 'scientifically proven', 'improves memory/focus/grades'). Full rule + the enforcement map: compliance.md section 3. Per-line claim_class tagging: ab-testing/hook-bank.json.",
    "signature_device": "SMART FELLA vs FART SMELLA binary: praise = Smart Fella, miss = Fart Smella '(for now)'."
  },
  "how_the_loop_uses_this": {
    "read": "Before generating/scheduling the next batch: read front_runners + rollups to bias toward the best-performing variant_family, hashtag_set, platform, and time_bucket; read decisions_log to avoid re-litigating settled questions (e.g. don't re-test intro). For any GENERATED copy (captions, comment replies, variants), read brand_voice.files first and match the SFFS voice + hard rules.",
    "write": "After each analytics pull (see ab-testing/README.md 'refresh metrics'): recompute every rollup from ab-database.json posts[] that have metrics.source != 'pending', update front_runners (highest median eng_rate with n_with_metrics >= min_n), append any new conclusion to decisions_log, and bump updated_at. Never delete history; supersede with a new decisions_log entry."
  },
  "status": "metrics pending — the 14 A/B posts are scheduled 2026-07-21 18:30 CDT through 2026-07-22 08:30 CDT, spread across the posting window as a TIME A/B (see time_buckets), and have not published yet. Rollups carry design counts (n_posts) with null metrics until the first analytics pull.",
  "conventions": {
    "primary_metric": "eng_rate (percent)",
    "secondary_metric": "reach",
    "aggregation": "use median, not mean (small sample, outliers like reach<10 noise posts); require min_n before acting",
    "min_n": 3,
    "dimensions": [
      "variant_family",
      "platform",
      "hashtag_set",
      "time_bucket"
    ]
  },
  "time_buckets": {
    "definition": {
      "evening": "~17:00-22:00 America/Chicago",
      "late-night": "~22:00-00:00",
