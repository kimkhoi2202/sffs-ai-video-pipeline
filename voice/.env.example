# ElevenLabs credentials for the voice/narration pipeline.
# Copy this file to `.env` (same folder) and fill in your key(s). NEVER commit .env.
#
#   cp .env.example .env
#
# Get a key at https://elevenlabs.io → Profile → API Keys. Keys start with "sk_".

# Required: your ElevenLabs API key (used by voice_pipeline.py, gen_sfx.py,
# gen_captions.py, regen_all.py, regen_score.py).
ELEVENLABS_API_KEY=

# Optional: only needed for the ONE-TIME voice clone reference pull in clone_voice.py
# (pulls a reference voice from an old account). Leave blank otherwise.
OLD_ELEVENLABS_API_KEY=
